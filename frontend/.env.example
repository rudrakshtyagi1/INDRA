# Frontend Environment Configuration for FloodLab
# Base URL of the FloodLab FastAPI backend (defaults to relative /api proxied by Vite)
VITE_API_BASE_URL=http://localhost:8000

# Optional: CARTO Basemap API Key (defaults to CartoDB Dark Matter free public tiles)
VITE_CARTO_BASEMAP_KEY=

# Optional: Cesium Ion Token (for 3D digital twin terrain if enabled)
VITE_CESIUM_ION_TOKEN=
