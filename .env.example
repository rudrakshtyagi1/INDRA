# Application
APP_ENV=development
SECRET_KEY=changeme-replace-in-production

# Database (primary: PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://floodlab:floodlab@localhost:5432/floodlab

# Database (fallback for testing / standalone dev)
TEST_DATABASE_URL=sqlite+aiosqlite:///./floodlab_test.db

# DualSPHysics — installed solver version recorded in manifest at runtime
DUALSPHYSICS_BIN_DIR=/opt/dualsphysics/bin
DUALSPHYSICS_VERSION=

# Delft3D FM — installed solver version recorded in manifest at runtime
DFLOWFM_BIN_DIR=/opt/delft3d/bin
DFLOWFM_VERSION=

# Storage
STORAGE_ROOT=./storage
DATA_ROOT=./data

# Google Earth Engine
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000
